#
# Set this to the AWS S3 prefix of where backups will go
#
PECO_BACKUPS_S3_PREFIX=s3://dmuth-peco/testing

#
# Our database path.  This is relative to the main directory of the app, 
# which is /app in the container.
#
SQLITE_DATABASE_PATH=db.sqlite

#
# Popupate the AWS credentials with:
#
#   aws configure export-credentials --format env
#
AWS_ACCESS_KEY_ID=FIXME
AWS_SECRET_ACCESS_KEY=FIXME

# Set to trigger an immediate backup for testing purposes
#PECO_BACKUP_IMMEDIATE=1
